/*
 * Bias add: data[gid] += bias[gid % dim]
 */
#version 450

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer BufData { float data[]; };
layout(set = 0, binding = 1) readonly buffer BufBias { float bias[]; };

layout(push_constant) uniform Params {
    int dim;
    int total;
};

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (int(gid) < total) {
        data[gid] += bias[gid % dim];
    }
}
